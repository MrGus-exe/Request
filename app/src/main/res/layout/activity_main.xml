<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <EditText
        android:id="@+id/edtxtCep"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:hint="Digite o CEP"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="200dp"></EditText>

    <Button
        android:id="@+id/btnBuscar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/edtxtCep"
        android:layout_centerHorizontal="true"
        android:text="Buscar"
        android:backgroundTint="#D81E62">

    </Button>

    <TextView
        android:id="@+id/exibir"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnBuscar">

    </TextView>

  </RelativeLayout>